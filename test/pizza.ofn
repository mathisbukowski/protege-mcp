Prefix(:=<http://example.org/pizza#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://example.org/pizza>
Declaration(Class(:Food))
Declaration(Class(:Pizza))
Declaration(Class(:Topping))
Declaration(Class(:Cheese))
Declaration(Class(:Meat))
Declaration(Class(:Vegetarian))
Declaration(Class(:Margherita))
Declaration(Class(:Pepperoni))
Declaration(Class(:ImpossiblePizza))
Declaration(Class(:Lonely))
Declaration(ObjectProperty(:hasTopping))
Declaration(DataProperty(:price))
Declaration(NamedIndividual(:myPizza))
Declaration(NamedIndividual(:mozzarella))
AnnotationAssertion(rdfs:label :Pizza "Pizza"@en)
AnnotationAssertion(rdfs:comment :Pizza "A baked flatbread.")
AnnotationAssertion(rdfs:label :Cheese "Fromage"@fr)
AnnotationAssertion(rdfs:label :Meat "Duplicate"@en)
AnnotationAssertion(rdfs:label :Food "Duplicate"@en)
SubClassOf(:Pizza :Food)
SubClassOf(:Topping :Food)
SubClassOf(:Cheese :Topping)
SubClassOf(:Meat :Topping)
DisjointClasses(:Cheese :Meat)
EquivalentClasses(:Vegetarian ObjectIntersectionOf(:Pizza ObjectAllValuesFrom(:hasTopping ObjectComplementOf(:Meat))))
SubClassOf(:Margherita :Pizza)
SubClassOf(:Margherita ObjectAllValuesFrom(:hasTopping :Cheese))
SubClassOf(:Pepperoni :Pizza)
SubClassOf(:Pepperoni ObjectSomeValuesFrom(:hasTopping :Meat))
SubClassOf(:ImpossiblePizza :Margherita)
SubClassOf(:ImpossiblePizza ObjectSomeValuesFrom(:hasTopping :Meat))
ObjectPropertyDomain(:hasTopping :Pizza)
ObjectPropertyRange(:hasTopping :Topping)
ClassAssertion(:Margherita :myPizza)
ClassAssertion(:Cheese :mozzarella)
ObjectPropertyAssertion(:hasTopping :myPizza :mozzarella)
)
